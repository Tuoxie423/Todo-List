page {
  min-height: 100vh;
  color: #1e293b;
  background: #eef4ff;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}

view,
text,
input,
button,
picker {
  box-sizing: border-box;
}

button {
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  padding: 0;
  border-radius: 999rpx;
  line-height: 1;
  overflow: hidden;
}

button::after {
  border: 0;
}

button[disabled] {
  opacity: 0.62;
}

.button-hover {
  transform: scale(0.98);
}