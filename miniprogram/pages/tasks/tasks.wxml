<view class="page">
  <view class="hero">
    <view>
      <text class="eyebrow">Todo List</text>
      <text class="title">任务台</text>
      <text class="room-name">当前清单：{{roomName}}</text>
    </view>
    <view class="status-card">
      <view class="status-dot {{apiOnline ? 'is-online' : 'is-offline'}}"></view>
      <view>
        <text class="status-label">Gin 后端状态</text>
        <text class="status-text">{{apiStatus}}</text>
      </view>
    </view>
  </view>

  <view class="metrics">
    <view class="metric">
      <text class="metric-number">{{totalCount}}</text>
      <text class="metric-label">总任务</text>
    </view>
    <view class="metric">
      <text class="metric-number">{{doneCount}}</text>
      <text class="metric-label">已完成</text>
    </view>
    <view class="metric accent">
      <text class="metric-number">{{progressRate}}%</text>
      <text class="metric-label">进度</text>
    </view>
  </view>

  <view class="panel">
    <view class="panel-heading">
      <view>
        <text class="eyebrow">Tasks</text>
        <text class="panel-title">任务清单</text>
      </view>
      <button class="ghost-button" bindtap="loadTasks">刷新</button>
    </view>

    <view class="task-form">
      <input class="task-input" value="{{taskTitle}}" placeholder="例如：整理部署步骤" bindinput="onTaskTitleInput" />
      <picker value="{{taskLevelIndex}}" range="{{levels}}" bindchange="onLevelChange">
        <view class="level-picker">{{levels[taskLevelIndex]}}</view>
      </picker>
      <button class="primary-button" bindtap="createTask">添加</button>
    </view>

    <text class="message">{{message}}</text>

    <view wx:if="{{!hasTasks}}" class="empty">任务清单是空的</view>
    <view wx:else class="task-list">
      <view wx:for="{{tasks}}" wx:key="id" class="task-item {{item.done ? 'is-done' : ''}}">
        <button class="toggle-button" data-id="{{item.id}}" bindtap="toggleTask">✓</button>
        <view class="task-main">
          <text class="task-title">{{item.title}}</text>
          <view class="task-meta"><text class="urgency-badge urgency-{{item.urgencyClass}}">{{item.level}}</text><text>{{item.createdAtText}}</text></view>
        </view>
        <button class="danger-button" data-id="{{item.id}}" bindtap="deleteTask">×</button>
      </view>
    </view>
  </view>

  <button class="change-room" bindtap="changeList">切换清单</button>
</view>
